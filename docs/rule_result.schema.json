{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule_result.schema.json",
  "title": "Operation Metrics Rule Results",
  "type": "object",
  "required": ["schema_version", "result_count", "hit_count", "results"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "result_count": { "type": "integer", "minimum": 0 },
    "hit_count": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "rule_id", "rule_name", "hit", "dimension", "period", "metrics", "threshold", "evidence"],
        "properties": {
          "module": { "type": "string", "pattern": "^S[1-4]$" },
          "rule_id": { "type": "string" },
          "rule_name": { "type": "string" },
          "hit": { "type": "boolean" },
          "dimension": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name"],
            "properties": {
              "type": { "type": "string" },
              "name": { "type": "string" }
            }
          },
          "period": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
              "end": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" }
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": ["number", "integer", "string", "boolean", "null"] }
          },
          "threshold": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
